 "cues": [
  {
   "index": 1,
   "start": 0.0,
   "end": 1.73,
   "text": "A Hawaiian bay disappeared"
  },
  {
   "index": 2,
   "start": 1.765,
   "end": 2.914,
   "text": "in less than a week."
  },
  {
   "index": 3,
   "start": 3.355,
   "end": 4.54,
   "text": "Kapoho Bay."
  },
  {
   "index": 4,
   "start": 4.818,
   "end": 6.258,
   "text": "March 2018."
  },
  {
   "index": 5,
   "start": 6.641,
   "end": 8.766,
   "text": "Then, on May 3rd, the ground"
  },
  {
   "index": 6,
   "start": 8.835,
   "end": 10.519,
   "text": "under a neighborhood split open."
  },
  {
   "index": 7,
   "start": 10.844,
   "end": 12.109,
   "text": "Twenty-four fissures."
  },
  {
   "index": 8,
   "start": 12.353,
   "end": 14.64,
   "text": "From orbit, Landsat's infrared"
  },
  {
   "index": 9,
   "start": 14.71,
   "end": 15.766,
   "text": "picked up the heat."
  },
  {
   "index": 10,
   "start": 16.091,
   "end": 17.67,
   "text": "One vent sent lava all"
  },
  {
   "index": 11,
   "start": 17.728,
   "end": 18.889,
   "text": "the way to the ocean."
  },
  {
   "index": 12,
   "start": 19.098,
   "end": 20.607,
   "text": "It reached Kapoho Bay"
  },
  {
   "index": 13,
   "start": 20.724,
   "end": 21.931,
   "text": "on June 3rd."
  },
  {
   "index": 14,
   "start": 22.256,
   "end": 24.624,
   "text": "By June 7th, the bay was gone."
  },
  {
   "index": 15,
   "start": 24.95,
   "end": 26.645,
   "text": "Nearly fourteen square miles"
  },
  {
   "index": 16,
   "start": 26.703,
   "end": 27.469,
   "text": "of lava."
  },
  {
   "index": 17,
   "start": 27.713,
   "end": 28.816,
   "text": "Over eighteen hundred"
  },
  {
   "index": 18,
   "start": 28.874,
   "end": 30.174,
   "text": "structures destroyed."
  },
  {
   "index": 19,
   "start": 30.499,
   "end": 32.426,
   "text": "Meanwhile, as magma drained"
  },
  {
   "index": 20,
   "start": 32.473,
   "end": 34.562,
   "text": "away, the summit collapsed."
  },
  {
   "index": 21,
   "start": 35.003,
   "end": 36.513,
   "text": "The caldera floor dropped"
  },
  {
   "index": 22,
   "start": 36.571,
   "end": 38.718,
   "text": "more than sixteen hundred feet."
  },
  {
   "index": 23,
   "start": 38.927,
   "end": 40.506,
   "text": "Hawaii gained eight hundred"
  },
  {
   "index": 24,
   "start": 40.622,
   "end": 42.712,
   "text": "seventy-five acres of new land."
  },
  {
   "index": 25,
   "start": 43.153,
   "end": 44.071,
   "text": "Who owns it?"
  },
  {
   "index": 26,
   "start": 44.512,
   "end": 45.441,
   "text": "Not the neighbors."
  },
  {
   "index": 27,
   "start": 45.684,
   "end": 48.123,
   "text": "Under a 1977 court ruling,"
  },
  {
   "index": 28,
   "start": 48.239,
   "end": 50.154,
   "text": "it belongs to the State."
  }
 ],
