 "cues": [
  {
   "index": 1,
   "start": 0.0,
   "end": 1.324,
   "text": "These farms run on water"
  },
  {
   "index": 2,
   "start": 1.37,
   "end": 2.821,
   "text": "from the last Ice Age."
  },
  {
   "index": 3,
   "start": 3.204,
   "end": 5.944,
   "text": "In 1987, this was empty desert."
  },
  {
   "index": 4,
   "start": 6.269,
   "end": 7.744,
   "text": "Then the circles came."
  },
  {
   "index": 5,
   "start": 8.127,
   "end": 8.998,
   "text": "Each is a farm"
  },
  {
   "index": 6,
   "start": 9.044,
   "end": 11.18,
   "text": "about a kilometer wide, watered"
  },
  {
   "index": 7,
   "start": 11.215,
   "end": 13.154,
   "text": "by a rotating sprinkler arm."
  },
  {
   "index": 8,
   "start": 13.595,
   "end": 16.184,
   "text": "By 1992, the desert kingdom"
  },
  {
   "index": 9,
   "start": 16.242,
   "end": 17.531,
   "text": "was exporting over two"
  },
  {
   "index": 10,
   "start": 17.624,
   "end": 19.192,
   "text": "million tons of wheat."
  },
  {
   "index": 11,
   "start": 19.575,
   "end": 20.55,
   "text": "The water is pumped"
  },
  {
   "index": 12,
   "start": 20.597,
   "end": 22.28,
   "text": "from deep aquifers filled"
  },
  {
   "index": 13,
   "start": 22.315,
   "end": 24.219,
   "text": "about twenty thousand years ago."
  },
  {
   "index": 14,
   "start": 24.66,
   "end": 26.378,
   "text": "Rain here can't refill them."
  },
  {
   "index": 15,
   "start": 27.191,
   "end": 28.515,
   "text": "In 2016,"
  },
  {
   "index": 16,
   "start": 28.665,
   "end": 30.012,
   "text": "Saudi Arabia ended"
  },
  {
   "index": 17,
   "start": 30.059,
   "end": 32.427,
   "text": "its wheat program to save water."
  },
  {
   "index": 18,
   "start": 32.752,
   "end": 33.867,
   "text": "Many farmers switched"
  },
  {
   "index": 19,
   "start": 33.89,
   "end": 35.55,
   "text": "to alfalfa, which uses"
  },
  {
   "index": 20,
   "start": 35.608,
   "end": 37.002,
   "text": "three times the water."
  },
  {
   "index": 21,
   "start": 37.605,
   "end": 39.44,
   "text": "That year, hydrologists"
  },
  {
   "index": 22,
   "start": 39.521,
   "end": 40.845,
   "text": "estimated about fifty"
  },
  {
   "index": 23,
   "start": 40.926,
   "end": 42.261,
   "text": "more years of pumping."
  },
  {
   "index": 24,
   "start": 42.505,
   "end": 44.014,
   "text": "All of this, built on water"
  },
  {
   "index": 25,
   "start": 44.061,
   "end": 45.744,
   "text": "that doesn't come back."
  }
