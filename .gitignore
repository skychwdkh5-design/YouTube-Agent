__pycache__/
*.pyc

# rendered media - never committed
*.mp4
*.partial.mp4

# generated narration and production folders - never committed
*.wav
*.mp3
productions/*
# exception: Episode 001 preproduction text (scripts, ledgers, storyboards only;
# media stays ignored by the *.mp4 / *.wav / *.mp3 rules above)
!productions/sahara-green/

# Landsat working data for Episode 001: never commit scene bundles or GeoTIFFs
productions/sahara-green/landsat/work/
productions/sahara-green/landsat/raw/
*.tar
*_refl.tif
*_B[0-9]*.TIF

# local-only test artefacts of the narration pipeline
productions/sahara-green/narration/voice/partial_test/

# EP005 first-15-second prototype (silent, 15 s, small)
!docs/knowledge/ep005-neom/prototype/first15s_proto.mp4

# EP005 production: keep text and small state, never heavy media or regenerable imagery
!productions/neom-line/
productions/neom-line/evidence/
productions/neom-line/graphics/
productions/neom-line/render/
productions/neom-line/voice/*.wav
productions/neom-line/voice/*.mp3
productions/neom-line/.lock
productions/neom-line/*.part
