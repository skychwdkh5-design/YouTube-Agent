__pycache__/
*.pyc

# rendered media - never committed
*.mp4
*.partial.mp4

# generated narration and production folders - never committed
*.wav
*.mp3
productions/*
# exception: Episode 001 preproduction text (scripts, ledgers, storyboards only;
# media stays ignored by the *.mp4 / *.wav / *.mp3 rules above)
!productions/sahara-green/
# Episode 002 preproduction text (research files only; media stays ignored)
!productions/dubai/

# Landsat working data for Episode 001: never commit scene bundles or GeoTIFFs
productions/sahara-green/landsat/work/
productions/sahara-green/landsat/raw/
*.tar
*_refl.tif
*_B[0-9]*.TIF

# local-only test artefacts of the narration pipeline
productions/sahara-green/narration/voice/partial_test/

# Natural Earth data (public domain; fetch with tools/fetch_natural_earth.sh)
data/natural_earth/

# EP002 paid TTS chunk cache (audio, regenerable only by paying again: keep in stable storage, not git)
productions/dubai/narration/voice/cache/

# New episodes (ep003-...): text, state and release package are committed; heavy or regenerable data is not
!productions/ep[0-9][0-9][0-9]-*/
productions/ep[0-9][0-9][0-9]-*/raw/
productions/ep[0-9][0-9][0-9]-*/work/
productions/ep[0-9][0-9][0-9]-*/seg/
productions/ep[0-9][0-9][0-9]-*/voice/cache/
productions/ep[0-9][0-9][0-9]-*/assets/

# Shorts productions: code and text only (videos stay ignored by *.mp4 / *.wav; deliverables live outside this public repo)
!productions/shorts-*/

# three.js vendor copy for tools/raster3d (fetched by fetch_three.sh)
tools/raster3d/vendor/
